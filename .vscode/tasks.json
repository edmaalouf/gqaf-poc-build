{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run PAIR API and handoff page",
			"type": "shell",
			"command": "env",
			"args": [
				"PAIR_DB=/tmp/pair-web-preview.sqlite3",
				"./.venv/bin/python",
				"-m",
				"flask",
				"--app",
				"pair.app",
				"run",
				"--host",
				"0.0.0.0",
				"--port",
				"5000"
			],
			"isBackground": true
		}
	]
}